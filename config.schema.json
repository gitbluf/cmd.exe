{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "dispath configuration",
	"type": "object",
	"properties": {
		"workspaceRoot": { "type": "string", "default": "~/.pi/agent/dispath" },
		"defaultAgents": { "type": "integer", "default": 3 },
		"defaultMission": {
			"type": "string",
			"default": "Infiltrate the monolith, extract creds, leave no trace."
		},
		"sandbox": {
			"type": "object",
			"properties": {
				"enabled": { "type": "boolean", "default": true },
				"allowedHosts": { "type": "array", "items": { "type": "string" } },
				"secrets": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"required": ["env", "hosts"],
						"properties": {
							"env": { "type": "string" },
							"hosts": { "type": "array", "items": { "type": "string" } }
						}
					}
				},
				"filesystem": {
					"type": "object",
					"properties": {
						"denyRead": { "type": "array", "items": { "type": "string" } },
						"readOnly": { "type": "array", "items": { "type": "string" } },
						"denyWrite": { "type": "array", "items": { "type": "string" } }
					}
				},
				"memory": { "type": "string" },
				"cpus": { "type": "integer", "minimum": 1 },
				"imagePath": {
					"type": "string",
					"description": "Path to a user-built Gondolin asset directory"
				},
				"toolPath": {
					"type": "string",
					"description": "Workspace-relative directory for guest-installed tools"
				}
			}
		}
	}
}
