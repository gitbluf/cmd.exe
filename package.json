{
	"name": "cmd.exe",
	"version": "0.1.0-alpha.0",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.14"
	},
	"pi": {
		"extensions": [
			"./src"
		]
	},
	"keywords": [
		"pi-package",
		"pi-extension"
	],
	"scripts": {
		"build": "bunx --bun --no-install tsc",
		"typecheck": "bunx --bun --no-install tsc --noEmit",
		"test": "bun test",
		"watch": "bunx --bun --no-install tsc --watch",
		"clean": "rm -rf dist",
		"lint": "bunx --bun --no-install biome lint .",
		"format": "bunx --bun --no-install biome format .",
		"check": "bunx --bun --no-install biome check .",
		"fix": "bunx --bun --no-install biome check --write .",
		"fix:unsafe": "bunx --bun --no-install biome check --write --unsafe ."
	},
	"dependencies": {
		"@earendil-works/gondolin": "0.12.0",
		"@earendil-works/pi-ai": "0.80.6",
		"@earendil-works/pi-coding-agent": "0.80.6",
		"@earendil-works/pi-tui": "0.80.6",
		"@sinclair/typebox": "0.34.52"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@types/bun": "1.3.14",
		"typescript": "7.0.2"
	}
}
