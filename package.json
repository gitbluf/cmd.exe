{
	"name": "cmd.exe",
	"version": "0.1.0-alpha.0",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"pi": {
		"extensions": [
			"./src"
		]
	},
	"keywords": [
		"pi-package",
		"pi-extension"
	],
	"scripts": {
		"build": "bun x tsc",
		"watch": "bun x tsc --watch",
		"clean": "rm -rf dist",
		"lint": "bun x biome lint .",
		"format": "bun x biome format .",
		"check": "bun x biome check .",
		"fix": "bun x biome check --write .",
		"fix:unsafe": "bun x biome check --write --unsafe ."
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.65",
		"@earendil-works/pi-ai": "0.80.6",
		"@earendil-works/pi-coding-agent": "0.80.6",
		"@earendil-works/pi-tui": "0.80.6",
		"@sinclair/typebox": "0.34.52"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"typescript": "7.0.2"
	}
}
