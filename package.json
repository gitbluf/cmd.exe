{
	"name": "cmd.exe",
	"version": "0.1.0-alpha.0",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"engines": {
		"node": ">=23.6.0"
	},
	"pi": {
		"extensions": [
			"./src"
		]
	},
	"keywords": [
		"pi-package",
		"pi-extension"
	],
	"scripts": {
		"build": "npx --no-install tsc",
		"watch": "npx --no-install tsc --watch",
		"clean": "rm -rf dist",
		"lint": "npx --no-install biome lint .",
		"format": "npx --no-install biome format .",
		"check": "npx --no-install biome check .",
		"test": "node --experimental-strip-types --test test/*.test.ts",
		"check:docs": "node scripts/check-docs.mjs",
		"fix": "npx --no-install biome check --write .",
		"fix:unsafe": "npx --no-install biome check --write --unsafe ."
	},
	"dependencies": {
		"@earendil-works/gondolin": "0.12.0",
		"@earendil-works/pi-ai": "0.83.0",
		"@earendil-works/pi-coding-agent": "0.83.0",
		"@earendil-works/pi-tui": "0.83.0",
		"@sinclair/typebox": "0.34.52"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"typescript": "7.0.2"
	}
}
