{
  "arch": "aarch64",
  "distro": "alpine",
  "env": {
    "PATH": "/root/.cargo/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "rootfsPackages": [
      "linux-virt",
      "bash",
      "ca-certificates",
      "curl",
      "git",
      "openssh-client",
      "build-base",
      "rust",
      "rustc",
      "rust-std",
      "cargo",
      "nodejs",
      "npm",
      "python3",
      "py3-pip",
      "ripgrep",
      "jq"
    ],
    "initramfsPackages": []
  },
  "rootfs": {
    "label": "cmd-exe-agent",
    "sizeMb": 4096
  },
  "runtimeDefaults": {
    "rootfsMode": "cow"
  },
  "postBuild": {
    "commands": [
      "set -eux; command -v cargo; command -v rustc; ls -l /usr/bin/rustc; /usr/bin/rustc -vV",
      "cargo install --git https://github.com/rtk-ai/rtk"
    ]
  },
  "cmdExe": {
    "runtime": {
      "imagePath": ".agents/sandbox-vm/agent-vm-assets",
      "memory": "4G",
      "cpus": 4
    }
  }
}
