{
  "arch": "aarch64",
  "distro": "alpine",
  "env": {
    "PATH": "/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "rootfsPackages": [
      "linux-virt",
      "bash",
      "ca-certificates",
      "curl",
      "gcompat",
      "git",
      "openssh-client",
      "nodejs",
      "npm",
      "python3",
      "py3-pip",
      "ripgrep",
      "jq"
    ],
    "initramfsPackages": []
  },
  "rootfs": {
    "label": "cmd-exe-agent",
    "sizeMb": 4096
  },
  "runtimeDefaults": {
    "rootfsMode": "cow"
  },
  "postBuild": {
    "commands": [
      "curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/tags/v0.44.0/install.sh | sh",
      "test -x /root/.local/bin/rtk",
      "install -m 0755 /root/.local/bin/rtk /usr/local/bin/rtk"
    ]
  },
  "cmdExe": {
    "runtime": {
      "imagePath": ".agents/sandbox-vm/agent-vm-assets",
      "memory": "4G",
      "cpus": 4
    }
  }
}
