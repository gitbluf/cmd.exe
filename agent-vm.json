{
  "arch": "aarch64",
  "distro": "alpine",
  "env": {
    "PATH": "/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "alpine": {
    "version": "3.23.0",
    "rootfsPackages": [
      "linux-virt",
      "bash",
      "git",
      "nodejs",
      "npm",
      "ca-certificates",
      "curl"
    ]
  },
  "rootfs": {
    "label": "cmd-exe-agent",
    "sizeMb": 4096
  },
  "runtimeDefaults": {
    "rootfsMode": "cow"
  },
  "cmdExe": {
    "runtime": {
      "imagePath": ".agents/sandbox-vm/agent-vm-assets",
      "memory": "4G",
      "cpus": 4
    }
  }
}
